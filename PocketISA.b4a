private Sub Leggi_Impostazioni
	' IP_SERVERPHP	PORTAPHP	IP_SERVERSQL	DITTA	UTENTE	VERSIONESW	ISTANZA_SERVERSQL	DBNAME_SERVERSQL	USER_SERVERSQL	PWD_SERVERSQL	DBNAME_PALMARE
	Dim rs As ResultSet 
	' VERIFICA SU TABELLA IMPOSTAZIONI
	DB_SQLite.Alter_Table_IS_IMPOSTAZIONI(SQLDataAccess)
	rs = SQLDataAccess.ExecQuery("select IP_SERVERPHP,PORTAPHP,IP_SERVERSQL,DITTA,UTENTE,ISTANZA_SERVERSQL,DBNAME_SERVERSQL,USER_SERVERSQL," _
	& "Pwd_ServerSQL,DBNAME_PALMARE,PWD_PALMARE,DEBUG,AltRiga,Mode_SPP,Path_Images,Path_DB from IMPOSTAZIONI")
	If (rs.RowCount=0) Then
		MsgboxAsync("Impostazioni non configurate!","SETTINGS")
		Dim sqlstr As String 
		sqlstr = "INSERT INTO IMPOSTAZIONI (IP_SERVERPHP,PortaPHP,IP_ServerSQL,Ditta,Utente,Istanza_ServerSQL," _ 
		 & "DBName_ServerSQL,User_ServerSQL,Pwd_ServerSQL,DBNAME_PALMARE,PWD_PALMARE,DEBUG,AltRiga,Mode_SPP,Path_Images) " _
		 & "VALUES ('','','','ZelariVi','Palmare','','VIVAIZELA','trm1','terminale','" & DBName & "','p','0',21,0,'')"
		SQLDataAccess.ExecNonQuery(sqlstr)
		Sleep(0)
	End If
	rs.Close
	rs = SQLDataAccess.ExecQuery("select rowid,IP_SERVERPHP,PORTAPHP,IP_SERVERSQL,DITTA,UTENTE,ISTANZA_SERVERSQL,DBNAME_SERVERSQL," _
	& "User_ServerSQL,Pwd_ServerSQL,DBNAME_PALMARE,PWD_PALMARE,DEBUG,REPEAT_ADD,IMAGES,QTA_DEFAULT,AltRiga,LargDescRiga,Mode_SPP,Path_images,Path_DB from IMPOSTAZIONI")
	Do While rs.NextRow
		IP_ServerPHP = rs.GetString("IP_SERVERPHP")
		PortaPHP = rs.GetString("PORTAPHP")
		IP_ServerSQL =rs.GetString("IP_SERVERSQL")
		' Ditta = rs.GetString("DITTA")
		Utente = rs.GetString("UTENTE")
		Istanza_ServerSQL = rs.GetString("ISTANZA_SERVERSQL")
		DBName_ServerSQL = rs.GetString("DBNAME_SERVERSQL")
		User_ServerSQL = rs.GetString("USER_SERVERSQL")
		Pwd_ServerSQL = rs.GetString("PWD_SERVERSQL")
		' DBName = rs.GetString("DBNAME_PALMARE")
		Pwd_DBName = rs.GetString("PWD_PALMARE")
		RowID_Impostazioni = rs.GetInt("rowid")
		DEBUG = rs.Getint("DEBUG")
		SwitchRepeatAdd = rs.GetInt("REPEAT_ADD")
		SwitchImages = rs.GetInt("IMAGES")
		SwitchQtaDefault = rs.GetInt("QTA_DEFAULT")
		AltRiga = rs.GetInt("AltRiga")
		LargDescRiga = rs.GetInt("LargDescRiga")
		SwitchMode_SPP = rs.GetInt("Mode_SPP")	
		PathImages = rs.GetString("Path_Images")
		Dim pathDbSql As String = rs.GetString("Path_DB")
		' Path DB: fonte primaria = pocketisa_pathdb.txt (gia' in PathDB/DirExt).
		' Path_DB in SQLite e' solo mirror; non deve sovrascrivere il config.
		Dim configPath As String = ""
		If PathDB <> Null Then configPath = PathDB.Trim
		If configPath <> "" Then
			ExtraUtility.DirExt = configPath
			' Import una tantum: se SQL e' vuoto/diverso, verra' riallineato dopo
		Else If pathDbSql <> Null And pathDbSql.Trim <> "" Then
			' Nessun config ancora: importa da SQLite e crea il file
			PathDB = pathDbSql.Trim
			ExtraUtility.DirExt = PathDB
			ExtraUtility.SavePathDBConfig(PathDB, DBName)
		End If
	Loop
	rs.Close
	' Allinea il mirror SQLite al config (senza usarlo per decidere dove aprire)
	ExtraUtility.SyncPathDbMirrorToSqlite(SQLDataAccess, PathDB, DBName, RowID_Impostazioni)
End Sub

Sub Activity_Create(FirstTime As Boolean)
	If (FirstTime) Then
		' ---------------------------------------------------------------------------------------
		' ---- SETTAGIO MULTI-DITTA ----
		' ---------------------------------------------------------------------------------------
		' Legge le informazioni dello schermo X e Y riportato a in dip...
		' ---------------------------------------------------------------------------------------		
		'DisplayMetrics metrics = Resources.getSystem().getDisplayMetrics();
		'float ScrDensity = metrics.density;
		'int metricHeight = metrics.heightPixels;//
		'int metricWidth = metrics.widthPixels;//		
		Dim r As Reflector
		r.Target = r.GetContext
		r.Target = r.RunMethod("getResources")
		r.Target = r.RunMethod("getDisplayMetrics")
		Device_ScreenXdip = r.GetField("xdpi")
		Device_ScreenYdip = r.GetField("ydpi")
		Device_Density = r.GetField("density")
		Device_ScreenX = r.GetField("widthPixels")
		Device_ScreenY = r.GetField("heightPixels")
		If Activity.Height > Activity.Width Then
			Device_Orientation = "portrait"
		Else
			Device_Orientation = "landscape"
		End If
		If(Ditta="Florenzi") Then
			Starter.UsaIntentScanner=True
		Else
			Starter.UsaIntentScanner=False
		End If
		If(Ditta="Nesti") Then
			'ph.SetScreenOrientation(0) ' -1 for unspesified, 0 for landscape and 1 for portrait
			If(Device_ScreenX>1900) And (Device_Orientation="landscape") Then
				ph.SetScreenOrientation(0) ' -1 for unspesified, 0 for landscape and 1 for portrait
			Else
				ph.SetScreenOrientation(1) ' -1 for unspesified, 0 for landscape and 1 for portrait
			End If
		Else
			ph.SetScreenOrientation(1) ' -1 for unspesified, 0 for landscape and 1 for portrait
		End If
		' ----------------------------------------------------------------------------------------
		Select Ditta
			Case "DEMO"
				'  *********** Inizio Settaggio multi-ditta *************
				Lista_Ditte = Array As String ("ZelariVi","Esseci","Nesti")    	' Zelarivi, Esseci.db
				Lista_DBname = Array As String ("Zelari.db","Esseci.db","Nesti.db")   ' Zelari.db, Esseci.db, Nesti.db
				'  *********** Fine Settaggio multi-ditta ***************
			
			Case "ZelariVi"
				'  *********** Inizio Settaggio ZelariVi *************
				Lista_Ditte = Array As String ("ZelariVi")      ' ZelariVi
				Lista_DBname = Array As String ("Zelari.db")    ' Zelari.db
				'  *********** Fine Settaggio ZelariVi ***************
			
			Case "Esseci"
				'  *********** Inizio Settaggio Esseci *************
				Lista_Ditte = Array As String ("Esseci")    	' Esseci
				Lista_DBname = Array As String ("Esseci.db")   	' Esseci.db
				'  *********** Fine Settaggio Esseci ***************
			
			Case "Kuore"
				'  *********** Inizio Settaggio Kuore *************
				Lista_Ditte = Array As String ("Kuore")    		' Kuore
				Lista_DBname = Array As String ("Kuore.db")   	' Kuore.db
				'  *********** Fine Settaggio Kuore ***************
			
			Case "Trendy"
				'  *********** Inizio Settaggio Trendy *************
				' Lista_Ditte = Array As String ("Trendy")    	 		' Trendy
				' Lista_DBname = Array As String ("Trendy.db")   		' Trendy.db
				' Lista_Ditte = Array As String ("COP")    		 		' COP
				' Lista_DBname = Array As String ("COP.db")   	 		' COP.db
				Lista_Ditte = Array As String ("COP","Trendy")  		' COP, Trendy
				Lista_DBname = Array As String ("COP.db","Trendy.db")   ' COP.db, Trendy.db
				'  *********** Fine Settaggio Trendy ***************

			Case "Nesti"
				'  *********** Inizio Settaggio Nesti *************
				Lista_Ditte = Array As String ("Nesti")    		' Nesti
				Lista_DBname = Array As String ("Nesti.db")   	' Nesti.db
				'  *********** Fine Settaggio Nesti ***************
				
			Case "Carbon"
				'  *********** Inizio Settaggio Carbon *************
				Lista_Ditte = Array As String ("Carbon")    	' Carbon
				Lista_DBname = Array As String ("Carbon.db")   	' Carbon.db
				'  *********** Fine Settaggio Carbon ***************
				
			Case "Gefin"
				'  *********** Inizio Settaggio Carbon *************
				Lista_Ditte = Array As String ("Gefin")    	' Carbon
				Lista_DBname = Array As String ("Gefin.db")   	' Carbon.db
				'  *********** Fine Settaggio Carbon ***************
				
			Case "Florenzi"
				'  *********** Inizio Settaggio Carbon *************
				Lista_Ditte = Array As String ("Florenzi")    	' Carbon
				Lista_DBname = Array As String ("Florenzi.db")   	' Carbon.db
				'  *********** Fine Settaggio Carbon ***************
				
		End Select
		DateTime.DateFormat = "dd-MM-yyyy"
	End If
	' Permesso necessario per leggere/scrivere /storage/emulated/0/db sulla SD
	rp.CheckAndRequest(rp.PERMISSION_WRITE_EXTERNAL_STORAGE)
	Wait For Activity_PermissionResult (Permission As String, Result As Boolean)
	If Result = False Then
		MsgboxAsync("Serve il permesso di accesso alla memoria per usare il database sulla SD.","PERMESSO")
	End If
	Activity.RemoveAllViews
	If (Ditta = "Carbon") Or (Ditta="Gefin") Or (Ditta="Florenzi") Then
		Activity.LoadLayout("GS_Login")
	Else
		Activity.LoadLayout("Login")
	End If
	Sleep(0)
	lstItems_Ditte.Initialize2(Lista_Ditte)
	lstItems_Utenti.Initialize2(Array As String(""))	
	' Log(lstIDs.get(2))
	' Base = Activity
	' Dialog.Initialize (Base)
	' Dialog.Title = "by Green Soft"
	' Activity.Title="POCKET ISA (" & VersioneSW & ")"
	lstItems_Ditte.Initialize2(Lista_Ditte)
	ComboBoxDitte.SetItems(lstItems_Ditte)
	DBName = Lista_DBname(ComboBoxDitte.SelectedIndex)
	' Path DB: PRIMA il file config (DirInternal), poi si apre il SQLite su quel path.
	' Mai il contrario: Path_DB dentro SQLite non puo' indicare dove sta il DB stesso.
	ExtraUtility.LoadPathDBConfig
	If DBName = "" Then DBName = Lista_DBname(ComboBoxDitte.SelectedIndex)
	ExtraUtility.CopyDBIfNeeded(DBName)
	SQLDataAccess.Initialize(ExtraUtility.DirExt, DBName, False)
	Leggi_Impostazioni
	lstItems_Utenti.Initialize2(Array As String(Utente))
	ComboBoxUtenti.SetItems(lstItems_Utenti)
	If (Ditta = "Carbon") Or (Ditta="Gefin") Or (Ditta="Florenzi") Then
		Dim FileName As String = Ditta & ".png"
		ExtraUtility.CopyIfNeeded(FileName,"logos")
		B4XImageView1.Load(ExtraUtility.rp.GetSafeDirDefaultExternal("logos"), FileName)
	End If
	If(Ditta="Florenzi") Then
		serialNo = ExtraUtility.GetAndroidID()
	Else
		serialNo = ExtraUtility.GetManufacturerSerialNumber()
	End If
	Starter.SerialNumber = serialNo
	Log ("S/N: " & Starter.SerialNumber)
End Sub

' Il risultato del permesso e' gestito con Wait For Activity_PermissionResult in Activity_Create.
' Non implementare Sub Activity_PermissionResult: intercetta l'evento e blocca il Wait For.



Sub Activity_Resume
	' vado a leggere il numero del listino minimo
	
End Sub

Sub Activity_Pause (UserClosed As Boolean)

End Sub

Sub ComboBoxDitte_SelectedIndexChanged (Index As Int)
	'Dialog.Show($"Selected item: ${ComboBoxDitte.GetItem(Index)}"$, "OK", "", "")
	DBName = Lista_DBname(ComboBoxDitte.SelectedIndex)
	ExtraUtility.CopyDBIfNeeded(DBName)
	SQLDataAccess.Initialize(ExtraUtility.DirExt, DBName, False)
	' MsgboxAsync(serialNo, "Your Serial Number")
	Leggi_Impostazioni
	lstItems_Utenti.Initialize2(Array As String(Utente))
	ComboBoxUtenti.SetItems(lstItems_Utenti)
End Sub

Sub B4XFloatTextField_Pwd_EnterPressed
	Dim stringa As String
	stringa = B4XFloatTextField_Pwd.TextField.Text
	If (stringa = Pwd_DBName) Then
		Select Ditta
			Case "ZelariVi"			
	    		NRListinoMin = DB_SQLite.Leggi_NRListinoMinimo(SQLDataAccess)
			Case Else
				NRListinoMin = 0
		End Select
		DittaScelta = ComboBoxDitte.GetItem(ComboBoxDitte.SelectedIndex)		
		If( DittaScelta = "COP") Then
			Ditta = "Trendy" ' come prsonalizzazione Trendy e COP sono identiche
		Else
			Ditta = DittaScelta
		End If
		If(Ditta="Florenzi") Then
			serialNo = ExtraUtility.GetAndroidID
		Else
			serialNo = ExtraUtility.GetManufacturerSerialNumber
		End If
		' ---------------------------------------------------------------------------------------
		Select Ditta
			Case "Florenzi"
				' GS = Green Soft
				PrefixSQL = "GS"
				MessageBoxText = "DATI"
				MessageNomeDitta = "Green Soft"
				
			Case "Trendy"
				' GS = Green Soft
				PrefixSQL = "GS"
				MessageBoxText = "DATI"
				MessageNomeDitta = "Green Soft"
				
			Case "Carbon"
				' GS = Green Soft
				PrefixSQL = "GS"
				MessageBoxText = "DATI"
				MessageNomeDitta = "Green Soft"
				
			Case "Gefin"
				' GS = Green Soft
				PrefixSQL = "GS"
				MessageBoxText = "DATI"
				MessageNomeDitta = "Green Soft"
								
			Case Else
				' IS = Idea Sistemi
				PrefixSQL = "IS"
				MessageBoxText = "DATI"
				MessageNomeDitta = "Green Soft"
				
		End Select
		' ---------------------------------------------------------------------------------------
		StartActivity(Choose_Menu)
		Activity.Finish
	Else		
		MsgboxAsync("Password errata!","ATTENZIONE")
	End If
End Sub

