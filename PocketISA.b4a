	' Public Ditta As String = "Carbon"  ' *************** CAMBIARE QUI LA DITTA *********************
	Public Ditta As String = "ZelariVi"  ' *************** CAMBIARE QUI LA DITTA *********************
	' ----------------------------------------------------------------------------------------------
	' ----------------------------------------------------------------------------------------------
	Public SelectionColor_Cyan As Int = 0xFF009DFF 	  ' cyan   FF009DFF
	Public SelectionColor_Green As Int = 0xFF11D504   ' verde  FF11D504
	Public SelectionColor_Red As Int = 0xFFFF3420 	  ' rosso  FFFF3420
	Public SelectionColor_Yellow As Int = 0xFFFFFF20  ' giallo FFFFFF20
	Public SelectionColor_Pink As Int = 0xFFF0B0FD    ' Rosa   FFFFFF20
	Public DittaScelta As String
	Private rp As RuntimePermissions
	Private SQLDataAccess As SQL
	' --- versione programma -------
	Dim VersioneSW As String = "1.2.96"
	Dim Utente As String = ""   ' "s.sogni"
	Dim IP_ServerSQL As String  
	Dim Istanza_ServerSQL As String
	Dim DBName As String = ""
	Dim DBName_ServerSQL As String 
	Dim User_ServerSQL As String
	Dim PrefixSQL As String = ""	
	Dim MessageBoxText As String = ""
	Dim MessageNomeDitta As String = ""
	Dim Pwd_ServerSQL As String
	Dim Pwd_DBName As String	
	Dim IP_ServerPHP As String
	Dim Folder_Php As String = "pocket_isa"
	Dim	PortaPHP As String	
	Dim RowID_Impostazioni As Int
	Dim DEBUG As Int
	Dim AltRiga As String
	Dim LargDescRiga As String
	Dim serialNo As String 
	Dim SwitchRepeatAdd As Int
	Dim SwitchImages As Int
	Dim SwitchQtaDefault As Int
	Dim SwitchMode_SPP As Int
	Dim PathImages As String
	Dim PathDB As String
	Dim NRListinoMin As Int
	Dim TimeOut As Int = 600000  ' Aggiunto un timeout di 10 minuti
	Dim mSoundPool As SoundPool
	Public Device_ScreenX As Double
	Public Device_ScreenY As Double
	Public Device_Density As Double
	Public Device_ScreenXdip As Double
	Public Device_ScreenYdip As Double
	Public Device_Orientation As String
End Sub

